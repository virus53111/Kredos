rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    function own(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isHost() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'host';
    }

    function validUser(uid) {
      let u = request.resource.data;
      return u.keys().hasAll(['uid','email','role','referralCode','createdAt','updatedAt'])
        && u.keys().hasOnly(['uid','email','role','referralCode','createdAt','updatedAt'])
        && u.uid == uid
        && u.email is string
        && u.email.size() <= 254
        && u.role in ['renter','host']
        && u.referralCode is string
        && u.referralCode.size() >= 5
        && u.referralCode.size() <= 12
        && u.createdAt is timestamp
        && u.updatedAt is timestamp;
    }

    function validDevice() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'ownerId','model','country','androidVersion','carrier','network',
          'status','public','hourlyRate','hostRate','createdAt','updatedAt'
        ])
        && d.keys().hasOnly([
          'ownerId','model','country','androidVersion','carrier','network',
          'status','public','hourlyRate','hostRate','createdAt','updatedAt'
        ])
        && d.ownerId is string
        && d.model is string && d.model.size() > 0 && d.model.size() <= 80
        && d.country is string && d.country.size() > 0 && d.country.size() <= 60
        && d.androidVersion is string && d.androidVersion.size() > 0 && d.androidVersion.size() <= 30
        && d.carrier is string && d.carrier.size() <= 60
        && d.network is string && d.network.size() <= 20
        && d.status in ['pending','offline','available']
        && d.public is bool
        && d.hourlyRate == 1
        && d.hostRate == 0.5
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if own(uid);
      allow create: if own(uid)
        && validUser(uid)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if own(uid)
        && validUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.referralCode == resource.data.referralCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /devices/{deviceId} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.public == true;

      allow create: if isHost()
        && request.resource.data.ownerId == request.auth.uid
        && validDevice()
        && request.resource.data.status == 'pending'
        && request.resource.data.public == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validDevice()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    match /wallets/{uid} {
      allow read: if own(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
