rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function admin() {
      return verified() && request.auth.token.email.lower() == 'dshtriters@gmail.com';
    }
    function moderator() {
      return verified() && exists(/databases/$(database)/documents/moderators/$(request.auth.token.email.lower()));
    }
    function manager() { return admin() || moderator(); }
    function validOrder() {
      let o = request.resource.data;
      return o.keys().hasAll(['name','address','items','state','createdBy','createdAt','updatedAt','revision'])
        && o.keys().hasOnly(['name','address','items','state','createdBy','createdAt','updatedAt','revision'])
        && o.name is string && o.name.size() > 0 && o.name.size() <= 200
        && o.address is string && o.address.size() <= 500
        && o.items is list && o.items.size() > 0 && o.items.size() <= 300
        && o.state in ['new','in_progress','completed']
        && o.createdBy is string && o.createdAt is timestamp
        && o.updatedAt == request.time && o.revision is int;
    }
    match /orders/{orderId} {
      allow read: if verified();
      allow create: if manager() && validOrder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.revision == 1;
      allow update: if manager() && validOrder()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if admin();
    }
    match /moderators/{email} {
      allow get: if verified() && (admin() || request.auth.token.email.lower() == email);
      allow list: if admin();
      allow create: if admin() && email != 'dshtriters@gmail.com'
        && email == email.lower() && email.size() <= 254
        && email.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
        && request.resource.data.keys().hasOnly(['email','assignedBy','createdAt'])
        && request.resource.data.email == email
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
